rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated and matches the path uid
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Function to check if required base fields exist
    function hasBaseFields() {
      return request.resource.data.createdAt != null &&
             request.resource.data.updatedAt != null &&
             request.resource.data.isDeleted is bool;
    }

    // All data is strictly isolated per admin user under /users/{adminUid}/
    match /users/{adminUid} {
      allow read, write: if isOwner(adminUid);

      // Customer subcollection
      match /customers/{customerId} {
        allow read, write: if isOwner(adminUid);
      }

      // Loans subcollection
      match /loans/{loanId} {
        allow read, write: if isOwner(adminUid);

        // Schedule subcollection under loan
        match /schedule/{scheduleId} {
          allow read, write: if isOwner(adminUid);
        }
      }

      // Payments subcollection
      match /payments/{paymentId} {
        allow read, write: if isOwner(adminUid);
      }

      // Audit logs (append-only)
      match /auditLogs/{logId} {
        allow read: if isOwner(adminUid);
        allow create: if isOwner(adminUid);
        allow update, delete: if false; // Append-only audit trail
      }

      // Reminders subcollection
      match /reminders/{reminderId} {
        allow read, write: if isOwner(adminUid);
      }

      // Settings doc
      match /settings/{settingsId} {
        allow read, write: if isOwner(adminUid);
      }

      // Daily analytics aggregations
      match /stats/daily/{date} {
        allow read, write: if isOwner(adminUid);
      }
    }
  }
}
