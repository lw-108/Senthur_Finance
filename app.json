{
  "expo": {
    "name": "SenthurFinance",
    "slug": "SenthurFinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vel.png",
    "scheme": "senthurfinance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/vel.png"
    },
    "android": {
      "adaptiveIcon": {
"backgroundColor": "#FFFFFF",
"foregroundImage": "./assets/images/vel.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.senthurfinance"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vel.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
"expo-splash-screen",
{
  "backgroundColor": "#FFFFFF",
  "image": "./assets/images/vinayagar.jpg",
  "imageWidth": 200,
  "resizeMode": "contain"
}
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-camera",
      "expo-file-system",
      "expo-contacts",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
"projectId": "9a480c1f-221e-4155-aace-99956575502c"
      }
    }
  }
}
