{
  "expo": {
    "name": "SenthurFinance",
    "slug": "SenthurFinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vel.png",
    "scheme": "senthurfinance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/vel.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/vel.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "SenthurFinance.com"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vel.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/vinayagar.jpg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a480c1f-221e-4155-aace-99956575502c"
      }
    }
  }
}