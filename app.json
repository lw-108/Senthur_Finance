{
  "expo": {
    "name": "SenthurFinance",
    "slug": "SenthurFinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vel.png",
    "scheme": "senthurfinance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/vel.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/vel.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.senthurfinance",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vel.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/vinayagar.jpg",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Senthur Finance to access your photos to select profile pictures and KYC documents.",
          "cameraPermission": "Allow Senthur Finance to access your camera to take profile photos and KYC documents."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Senthur Finance to access your contacts to import and merge borrowers."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-camera",
      "expo-file-system",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a480c1f-221e-4155-aace-99956575502c"
      }
    }
  }
}
